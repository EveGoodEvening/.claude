#!/usr/bin/env bash
# heavy-gate: machine-wide gate for memory-heavy commands (headless browsers / Playwright / Puppeteer,
# Electron, emulators, big builds). Shared by every project, session and agent on this box.
#
#   heavy-gate [-n SLOTS] [-m MEMORY_MAX] [-l LABEL] -- cmd args...   run cmd once it may start
#   heavy-gate --status                                                 show holders + free memory
#
# - At most HEAVY_GATE_SLOTS (2) slots are held at once; a command that starts N browsers takes -n N.
# - A command starts only while MemAvailable >= HEAVY_GATE_MIN_FREE_MB (4500); launches are spaced
#   HEAVY_GATE_SETTLE seconds (20) apart so the previous one's memory shows up before the next check.
# - It WAITS (message on stderr every 30 s), it never fails for lack of room: run long waits in the
#   background, never under `timeout`.
# - The command runs in its own systemd scope capped at MEMORY_MAX (HEAVY_GATE_MEM_MAX, 6G) with
#   oom_score_adj 500, so a runaway is killed inside that scope instead of a global OOM taking the
#   tmux scope (and the Claude Code session) down with it.
# - Slots are flock(1) locks inherited by the command and all its children: they free themselves
#   when the last process exits, crashed or not. A slot that stays busy = an orphan still running.
set -u

SLOTS=${HEAVY_GATE_SLOTS:-2}
MIN_FREE_MB=${HEAVY_GATE_MIN_FREE_MB:-4500}
MEM_MAX=${HEAVY_GATE_MEM_MAX:-6G}
SETTLE=${HEAVY_GATE_SETTLE:-20}
DIR=${HEAVY_GATE_DIR:-/tmp/heavy-gate}
mkdir -p "$DIR"

mem_free_mb() { awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo; }

if [[ ${1:-} == --status ]]; then
  echo "MemAvailable $(mem_free_mb) MB (need $MIN_FREE_MB), $SLOTS slots in $DIR"
  for ((i = 0; i < SLOTS; i++)); do
    f="$DIR/slot-$i"
    if [[ -e $f ]] && ! flock -n "$f" true 2>/dev/null; then echo "slot-$i busy: $(cat "$f")"; else echo "slot-$i free"; fi
  done
  exit 0
fi

need=1 label=""
while getopts "n:m:l:" opt; do
  case $opt in
    n) need=$OPTARG ;;
    m) MEM_MAX=$OPTARG ;;
    l) label=$OPTARG ;;
    *) echo "usage: heavy-gate [-n SLOTS] [-m MEMORY_MAX] [-l LABEL] -- cmd args..." >&2; exit 64 ;;
  esac
done
shift $((OPTIND - 1))
[[ ${1:-} == -- ]] && shift
(($# > 0)) || { echo "heavy-gate: no command" >&2; exit 64; }
((need >= 1 && need <= SLOTS)) || { echo "heavy-gate: -n must be 1..$SLOTS" >&2; exit 64; }
label=${label:-"$(basename "$PWD"): $*"}
label=${label:0:160}

held=()
release() { for fd in "${held[@]}"; do exec {fd}>&-; done; held=(); }

# Take `need` slots all at once or none (no hold-and-wait, so no deadlock between -n 2 commands).
try_slots() {
  local i fd
  for ((i = 0; i < SLOTS && ${#held[@]} < need; i++)); do
    exec {fd}<>"$DIR/slot-$i"
    if flock -n "$fd"; then held+=("$fd"); else exec {fd}>&-; fi
  done
  ((${#held[@]} == need)) && return 0
  release
  return 1
}

t0=$SECONDS last=-30
while :; do
  reason=""
  if try_slots; then
    exec {launch}<>"$DIR/launch"
    flock "$launch"
    free=$(mem_free_mb)
    ((free >= MIN_FREE_MB)) && break
    exec {launch}>&-
    release
    reason="MemAvailable $free MB < $MIN_FREE_MB MB"
  else
    reason="all $SLOTS slots busy"
  fi
  if ((SECONDS - last >= 30)); then
    last=$SECONDS
    echo "[heavy-gate] waiting $((SECONDS - t0)) s: $reason ($label)" >&2
    for f in "$DIR"/slot-*; do [[ -s $f ]] && echo "[heavy-gate]   $(basename "$f"): $(cat "$f")" >&2; done
  fi
  sleep $((2 + RANDOM % 3))
done

for fd in "${held[@]}"; do
  echo "pid $$ since $(date '+%F %T') ${label}" > "$(readlink "/proc/$$/fd/$fd")"
done
# Hold the launch lock a little longer from a background sleep so the next launcher measures memory
# with this command already running; the command itself must not inherit that lock.
( for fd in "${held[@]}"; do exec {fd}>&-; done; exec sleep "$SETTLE" ) &
settle=$!
exec {launch}>&-

echo 500 > /proc/self/oom_score_adj 2>/dev/null
if systemd-run --user --scope --quiet --collect true 2>/dev/null; then
  systemd-run --user --scope --quiet --collect -p MemoryMax="$MEM_MAX" -p MemorySwapMax=0 -- "$@"
else
  "$@"
fi
rc=$?
kill "$settle" 2>/dev/null
for fd in "${held[@]}"; do : > "$(readlink "/proc/$$/fd/$fd")"; done
exit $rc
