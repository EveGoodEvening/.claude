#!/usr/bin/env python3
"""PreToolUse(Bash) hook: deny commands that start a headless browser unless they run under heavy-gate.

Detects, per simple command (after `cd`, env assignments, nohup/timeout/... wrappers):
  - the Playwright CLI (`npx playwright test|screenshot|pdf|open|codegen|...`, `python -m playwright ...`)
  - a Chrome/Chromium binary
  - node/deno/bun/tsx/python running a script file that imports playwright/puppeteer/selenium,
    directly or through a local import (depth 2), or inline code / heredocs that do
  - npm/pnpm/yarn/bun scripts whose package.json command does any of the above
A simple command whose program is heavy-gate is gated and not inspected. Any internal error allows.
"""
import json
import os
import re
import shlex
import sys

GATE = "~/.claude/bin/heavy-gate"
PREFILTER = re.compile(
    r"playwright|puppeteer|selenium|chrom|headless|\bnode\b|python|\bdeno\b|\bbun|\btsx\b|ts-node|\bnpm\b|\bpnpm\b|\byarn\b|\bnpx\b")
INDICATOR = re.compile(
    r"""['"](?:playwright|playwright-core|playwright-chromium|@playwright/test|puppeteer|puppeteer-core)['"]"""
    r"|\b(?:chromium|firefox|webkit|puppeteer)\.(?:launch|launchPersistentContext|launch_persistent_context|launchServer|connect)\b"
    r"|\bfrom\s+playwright\b|\bimport\s+playwright\b|\bsync_playwright\b|\basync_playwright\b|\bpyppeteer\b|\bfrom\s+selenium\b|\bimport\s+selenium\b")
LOCAL_IMPORT = re.compile(r"""(?:\bfrom\s*|\bimport\s*\(\s*|\brequire\s*\(\s*|\bimport\s+)['"](\.{1,2}/[^'"]+)['"]""")
PW_LAUNCHING = {"test", "screenshot", "pdf", "open", "codegen", "cr", "ff", "wk", "show-trace"}
PW_NAMES = {"playwright", "playwright-core", "@playwright/test"}
CHROME = {"chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "chrome", "headless_shell",
          "chrome-headless-shell"}
WRAPPERS = {"sudo", "nohup", "exec", "time", "nice", "ionice", "stdbuf", "setsid", "unbuffer", "command", "builtin"}
SHELLS = {"bash", "sh", "zsh", "dash"}
JS_RUNTIMES = {"node", "nodejs", "deno", "tsx", "ts-node", "bun"}
OPERATORS = {";", "&&", "||", "|", "&", "(", ")", "|&", ";;", "\n"}
HEREDOC = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1[^\n]*\n(.*?)\n[ \t]*\2[ \t]*(?=\n|$)", re.S)
JS_EXT = ("", ".mjs", ".js", ".ts", ".mts", ".cjs", ".cts", "/index.mjs", "/index.js", "/index.ts")


def read(path, limit=2_000_000):
    try:
        if os.path.isfile(path) and os.path.getsize(path) <= limit:
            with open(path, encoding="utf-8", errors="replace") as f:
                return f.read()
    except OSError:
        pass
    return None


def file_launches(path, depth=0, seen=None):
    seen = seen if seen is not None else set()
    real = os.path.realpath(path)
    if real in seen or len(seen) > 40:
        return None
    seen.add(real)
    text = read(real)
    if text is None:
        return None
    if INDICATOR.search(text):
        return path
    if depth < 2 and not real.endswith(".py"):
        base = os.path.dirname(real)
        for rel in LOCAL_IMPORT.findall(text):
            for ext in JS_EXT:
                cand = os.path.normpath(os.path.join(base, rel + ext))
                if os.path.isfile(cand):
                    hit = file_launches(cand, depth + 1, seen)
                    if hit:
                        return f"{path} -> {hit}"
                    break
    return None


def progname(word):
    word = re.sub(r"(?<=.)@[^/]*$", "", word)  # drop an npx version suffix: playwright@1.63.0
    return word if word.startswith("@") else os.path.basename(word)


def split_commands(cmd):
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=";&|()")
    lex.whitespace_split = True
    lex.commenters = ""
    cur = []
    for tok in lex:
        if tok in OPERATORS or set(tok) <= set(";&|()"):
            if cur:
                yield cur
            cur = []
        else:
            cur.append(tok)
    if cur:
        yield cur


def strip_prefix(words):
    """Drop env assignments and wrapper programs; return the words starting at the real program."""
    i = 0
    while i < len(words):
        w = words[i]
        b = os.path.basename(w)
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w) or w == "$":
            i += 1
        elif b in WRAPPERS:
            i += 1
            while i < len(words) and words[i].startswith("-"):
                i += 1
        elif b == "env":
            i += 1
            while i < len(words) and (words[i].startswith("-") or "=" in words[i]):
                i += 1
        elif b == "timeout":
            i += 1
            while i < len(words) and words[i].startswith("-"):
                i += 2 if words[i] in ("-s", "-k", "--signal", "--kill-after") else 1
            i += 1  # duration
        elif b == "xvfb-run":
            i += 1
            while i < len(words) and words[i].startswith("-"):
                i += 1
        else:
            break
    return words[i:]


class Checker:
    def __init__(self, cwd, heredocs):
        self.cwd = cwd
        self.heredocs = heredocs

    def path(self, p, cwd):
        return os.path.normpath(os.path.join(cwd, os.path.expanduser(p)))

    def command_string(self, cmd, cwd, depth):
        if depth > 4:
            return None
        for words in split_commands(cmd):
            words = strip_prefix(words)
            if not words:
                continue
            prog = progname(words[0])
            if prog == "cd":
                target = words[1] if len(words) > 1 else "~"
                if target != "-":
                    cwd = self.path(target, cwd)
                continue
            hit = self.simple(prog, words, cwd, depth)
            if hit:
                return hit
        return None

    def simple(self, prog, words, cwd, depth):
        args = words[1:]
        if prog == "heavy-gate":
            return None
        if prog in PW_NAMES or re.fullmatch(r"playwright@\S+", prog):
            sub = next((a for a in args if not a.startswith("-")), None)
            if sub in PW_LAUNCHING and not {"--list", "--help", "-h"} & set(args):
                return f"`playwright {sub}` starts browsers"
            return None
        if prog in CHROME:
            if args and not set(args) <= {"--version", "--help", "-h"}:
                return f"`{prog}` is a browser"
            return None
        if prog in SHELLS:
            for i, a in enumerate(args[:-1]):
                if a == "-c" or (a.startswith("-") and not a.startswith("--") and a.endswith("c")):
                    return self.command_string(args[i + 1], cwd, depth + 1)
            script = next((a for a in args if not a.startswith("-")), None)
            if script and read(self.path(script, cwd)) is not None:
                return self.command_string(read(self.path(script, cwd)), cwd, depth + 1)
            return None
        if prog in ("npx", "bunx", "pnpx"):
            rest, i = list(args), 0
            while i < len(rest) and rest[i].startswith("-"):
                i += 2 if rest[i] in ("-p", "--package", "-c", "--call") else 1
            if i < len(rest):
                return self.simple(progname(rest[i]), rest[i:], cwd, depth)
            return None
        if prog in ("npm", "pnpm", "yarn") or (prog == "bun" and args and args[0] not in ("test",) and
                                               not re.search(r"\.[cm]?[jt]s$", args[0])):
            return self.package_runner(prog, args, cwd, depth)
        if prog in JS_RUNTIMES or re.fullmatch(r"python[0-9.]*|pypy3?", prog):
            return self.interpreter(prog, args, cwd)
        return None

    def package_runner(self, prog, args, cwd, depth):
        pkg_dir, rest, i = cwd, [], 0
        while i < len(args):
            a = args[i]
            if a in ("--prefix", "-C", "--dir", "--cwd") and i + 1 < len(args):
                pkg_dir = self.path(args[i + 1], cwd)
                i += 2
                continue
            m = re.match(r"--(?:prefix|dir|cwd)=(.+)", a)
            if m:
                pkg_dir = self.path(m.group(1), cwd)
            elif not a.startswith("-") or rest:
                rest.append(a)
            i += 1
        if not rest:
            return None
        verb = rest[0]
        if verb in ("exec", "x", "dlx") and len(rest) > 1:
            tail = [a for a in rest[1:] if a != "--"]
            return self.simple(progname(tail[0]), tail, cwd, depth) if tail else None
        name = rest[1] if verb in ("run", "run-script", "rum", "urn") and len(rest) > 1 else verb
        if verb in ("t", "tst"):
            name = "test"
        pkg = read(os.path.join(pkg_dir, "package.json"))
        scripts = {}
        if pkg:
            try:
                scripts = json.loads(pkg).get("scripts") or {}
            except ValueError:
                scripts = {}
        if name in scripts:
            hit = self.command_string(scripts[name], pkg_dir, depth + 1)
            return f"script `{name}` -> {hit}" if hit else None
        if re.search(r"\.[cm]?[jt]s$", name):
            return self.interpreter("node", [name], pkg_dir)
        if prog in ("pnpm", "yarn", "bun") and verb not in ("run", "install", "add", "i"):
            return self.simple(progname(rest[0]), rest, pkg_dir, depth)
        return None

    def interpreter(self, prog, args, cwd):
        is_py = prog.startswith("py")
        i = 0
        while i < len(args):
            a = args[i]
            if is_py and a == "-c" or not is_py and a in ("-e", "--eval", "-p", "--print"):
                code = args[i + 1] if i + 1 < len(args) else ""
                return f"inline {prog} code" if INDICATOR.search(code) else None
            if is_py and a == "-m" and i + 1 < len(args):
                mod = args[i + 1]
                if mod == "playwright":
                    sub = next((x for x in args[i + 2:] if not x.startswith("-")), None)
                    return f"`playwright {sub}` starts browsers" if sub in PW_LAUNCHING else None
                return None
            if a in ("-r", "--require", "--import", "--loader", "-W", "-X") and i + 1 < len(args):
                i += 2
                continue
            if a == "-" or not a.startswith("-"):
                break
            i += 1
        script = args[i] if i < len(args) else "-"
        if prog == "deno" and script in ("run", "test", "eval") and i + 1 < len(args):
            script = next((x for x in args[i + 1:] if not x.startswith("-")), "-")
        if prog == "bun" and script == "run" and i + 1 < len(args):
            script = args[i + 1]
        if script == "-" or script.startswith(("-", "<")):
            return f"{prog} stdin/heredoc" if any(INDICATOR.search(h) for h in self.heredocs) else None
        hit = file_launches(self.path(script, cwd))
        if hit:
            return f"`{script}` uses a browser ({hit})"
        if any(INDICATOR.search(h) for h in self.heredocs):
            return f"`{script}` runs next to a heredoc that uses a browser"
        return None


def decide(command, cwd):
    if not PREFILTER.search(command):
        return None
    heredocs = [m.group(3) for m in HEREDOC.finditer(command)]
    stripped = HEREDOC.sub(lambda m: m.group(0).split("\n", 1)[0] + "\n", command)
    stripped = stripped.replace("\\\n", " ").replace("\n", " ; ")
    checker = Checker(cwd, heredocs)
    try:
        return checker.command_string(stripped, cwd, 0)
    except ValueError:  # unbalanced quotes etc.: coarse fallback on the raw text
        if re.search(r"\b(?:npx|bunx|pnpm\s+exec|yarn)\s+playwright\s+(?:" + "|".join(PW_LAUNCHING) + r")\b", command) \
                and "heavy-gate" not in command:
            return "`playwright` CLI starts browsers"
        return None


def main():
    try:
        data = json.load(sys.stdin)
        command = (data.get("tool_input") or {}).get("command") or ""
        cwd = data.get("cwd") or os.getcwd()
        why = decide(command, cwd)
    except Exception:
        return 0
    if not why:
        return 0
    reason = (
        f"Blocked: this command starts a headless browser ({why}). Browsers (3-4 GB each) must go through the "
        f"machine-wide memory gate, or parallel agents OOM the box and kill the whole session. Rerun it as "
        f"`{GATE} -l '<short label>' -- <the browser command>` (put `cd`/env before the gate, or wrap a compound command "
        f"in `bash -c`), with run_in_background: true; the gate may wait minutes for a slot, so never wrap it in "
        f"`timeout`. A command that starts N browsers takes `-n N` (max 2); prefer --workers=1. "
        f"`{GATE} --status` shows who holds the slots. See ~/.claude/CLAUDE.md.")
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason}}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
